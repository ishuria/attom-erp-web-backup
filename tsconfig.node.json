{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./*"],
      "/@/*": ["./src/*"],
      "/#/*": ["./types/*"],
      "/@vab/*": ["./library/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "library/**/*.ts",
    "library/**/*.vue",
    "src/**/*.ts",
    "src/**/*.vue",
    "mock/**/*.ts",
    "mock/**/*.vue",
    "types/**/*.d.ts"
  ]
}
