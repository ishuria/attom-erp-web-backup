{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "~/*": ["./*"],
      "/@/*": ["./src/*"],
      "/#/*": ["./types/*"],
      "/@vab/*": ["./library/*"]
    }
  },
  "include": ["vite.config.ts", "library/build/index.ts"]
}
