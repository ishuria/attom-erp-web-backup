    "chokidar": "^3.5.3",
    "eslint": "^8.48.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "lint-staged": "^14.0.1",
    "picocolors": "^1.0.0",
    "postcss-html": "^1.5.0",
    "prettier": "^3.0.2",
    "sass": "^1.66.1",
