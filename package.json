{
    "name": "shop-vite",
    "version": "26.8.0",
    "private": true,
    "author": "github.com/zxwk1998",
    "scripts": {
        "dev": "vite",
        "dev:vue-tsc": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite",
        "dev:https": "cross-env VITE_CJS_IGNORE_WARNING=true vite --config ./vite.config.dev.ts",
        "vue-tsc": "vue-tsc --noEmit",
        "build": "vite build",
        "build:fast": "node scripts/.hidden-check.js && cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build",
        "build:report": "cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build --config ./vite.config.dev.ts",
        "build:website": "node scripts/.hidden-check.js && cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build --config ./vite.config.website.ts && node write.version.js",
        "build:vue-tsc": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite build",
        "preview": "cross-env VITE_CJS_IGNORE_WARNING=true vite preview",
        "lint:eslint": "eslint . --fix",
        "lint:oxlint": "oxlint",
        "lint:oxlint:fix": "oxlint --fix",
        "lint:prettier": "prettier {src,mock,library,types}/**/*.{html,vue,css,sass,scss,js,ts} --write",
        "lint:stylelint": "stylelint {src,mock,library}/**/*.{vue,css,sass,scss} --fix --cache --cache-location node_modules/.cache/stylelint/",
        "global:install": "npm i -g nrm cnpm npm-check-updates pnpm",
        "globle:update": "ncu -g",
        "module:install": "pnpm i",
        "module:update": "ncu -u --reject vite-plugin-mock,@vitejs/plugin-vue-jsx,eslint,eslint-plugin-unicorn,vue-echarts,chokidar,@opentiny/vue && npm run module:install",
        "module:reinstall": "rimraf node_modules && npm run module:install",
        "git": "start ./git.sh",
        "generate-pwa-assets": "pwa-assets-generator",
        "protect": "node scripts/protection.js",
        "template": "plop",
        "predev": "node scripts/.hidden-check.js",
        "prebuild": "node scripts/.hidden-check.js"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@kangc/v-md-editor": "^2.3.18",
        "@logicflow/core": "^2.0.16",
        "@logicflow/extension": "^2.0.21",
        "@lucky-canvas/vue": "^0.1.11",
        "@opentiny/vue": "3.18.0",
        "@vueuse/core": "^13.4.0",
        "@vueuse/head": "^2.0.0",
        "@wangeditor/editor": "^5.1.23",
        "@wangeditor/editor-for-vue": "^5.1.12",
        "axios": "^1.10.0",
        "core-security": "^1.2.0",
        "dayjs": "^1.11.13",
        "disable-devtool": "^0.3.8",
        "echarts": "^5.6.0",
        "element-plus": "^2.10.2",
        "file-saver": "^2.0.5",
        "jsencrypt": "^3.3.2",
        "lodash-es": "^4.17.21",
        "mitt": "^3.0.1",
        "mockjs": "^1.1.0",
        "normalize.css": "^8.0.1",
        "nprogress": "^0.2.0",
        "pinia": "^3.0.3",
        "qs": "^6.14.0",
        "sortablejs": "^1.15.6",
        "typeit": "^8.8.7",
        "vsv-context-menu": "^1.4.2",
        "vsv-icon": "^2.2.2",
        "vue": "^3.5.17",
        "vue-draggable-plus": "^0.6.0",
        "vue-echarts": "6.7.3",
        "vue-i18n": "^11.1.7",
        "vue-json-viewer": "^3.0.4",
        "vue-pdf-embed": "^2.1.2",
        "vue-qr": "^4.0.9",
        "vue-router": "^4.5.1",
        "vue3-gantt": "1.1.8-7",
        "vue3-puzzle-vcode": "^1.1.7",
        "xgplayer": "^3.0.22",
        "xgplayer-hls.js": "^3.0.22",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@element-plus/eslint-config": "^2.9.10",
        "@types/file-saver": "^2.0.7",
        "@types/lodash-es": "^4.17.12",
        "@types/mockjs": "^1.0.10",
        "@types/nprogress": "^0.2.3",
        "@types/qs": "^6.14.0",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitejs/plugin-basic-ssl": "^2.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vitejs/plugin-vue-jsx": "5.0.0",
        "@vue/compiler-sfc": "^3.5.17",
        "adm-zip": "^0.5.16",
        "autoprefixer": "^10.4.21",
        "chokidar": "^3.6.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.56.0",
        "eslint-define-config": "^2.1.0",
        "eslint-plugin-unicorn": "^56.0.1",
        "lint-staged": "^16.1.2",
        "oxlint": "^1.4.0",
        "picocolors": "^1.1.1",
        "plop": "^4.0.1",
        "postcss": "^8.5.6",
        "postcss-html": "^1.8.0",
        "prettier": "^3.6.2",
        "rollup-plugin-visualizer": "^6.0.3",
        "sass": "1.89.2",
        "stylelint": "^16.21.0",
        "stylelint-config-recess-order": "^7.1.0",
        "stylelint-config-recommended-scss": "^15.0.1",
        "stylelint-config-recommended-vue": "^1.6.1",
        "terser": "^5.43.1",
        "typescript": "^5.8.3",
        "unplugin-auto-import": "^19.3.0",
        "unplugin-vue-components": "^28.8.0",
        "vite": "^7.0.0",
        "vite-plugin-banner": "^0.8.1",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-mock": "2.9.8",
        "vite-plugin-pwa": "^1.0.1",
        "vite-plugin-svg-icons": "^2.0.1",
        "vite-plugin-unplugin": "^1.8.0",
        "vite-plugin-vitebar": "^0.0.8",
        "vue-tsc": "^2.2.10"
    },
    "gitHooks": {
        "pre-commit": "lint-staged"
    },
    "homepage": "https://vuejs-core.cn/shop-vite",
    "license": "Mozilla Public License Version 2.0",
    "lint-staged": {
        "*.{js,ts,vue}": [
            "oxlint --fix",
            "npm run lint:prettier",
            "git add"
        ]
    },
    "participants": [
        "FlowPeakFish"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zxwk2024/shop-vite.git"
    }
}
