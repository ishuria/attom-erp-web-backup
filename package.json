    "mitt": "^3.0.1",
    "mockjs": "^1.1.0",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.6",
    "qs": "^6.11.2",
    "typeit": "^8.7.1",
    "vsv-icon": "^1.0.0",
    "vue": "^3.3.4",
    "vue-echarts": "^6.6.1",
    "vue-i18n": "^9.2.2",
