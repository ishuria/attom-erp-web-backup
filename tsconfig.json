{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "~/*": ["./*"],
      "/@/*": ["./src/*"],
      "/#/*": ["./types/*"],
      "/@vab/*": ["./library/*"]
    },
    "lib": ["dom", "esnext", "scripthost", "dom.iterable"],
    "skipLibCheck": true,
    "types": [
      "element-plus/global",
      "unplugin-vue-define-options/macros-global"
    ]
  },
  "include": [
    "vite.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "mock/**/*.ts",
    "mock/**/*.d.ts",
    "types/**/*.d.ts",
    "library/**/*.ts",
    "library/**/*.d.ts",
    "library/**/*.tsx",
    "library/**/*.vue"
  ]
}
